# ==========================================================================
# Career Copilot — configuración de entorno
# Copia este archivo a `.env` y rellena los valores.
#   cp .env.example .env
# ==========================================================================

# --- Claude / Anthropic -------------------------------------------------
# Obligatorio para parsing de CV, tailoring, cover letters, intel y mock interview.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo principal. claude-opus-5-5 es el más capaz; claude-sonnet-5 es ~2x
# más barato y suficiente si haces muchísimas llamadas.
LLM_MODEL=claude-opus-5-5
# Modelo para tareas de volumen/baratas (normalizar vacantes scrapeadas).
LLM_FAST_MODEL=claude-haiku-4-5
# low | medium | high | xhigh | max  — controla profundidad de razonamiento y costo.
LLM_EFFORT=high

# --- Embeddings (matching semántico) ------------------------------------
# Anthropic no ofrece API de embeddings. Opciones:
#   local  -> hashing determinista, cero dependencias externas, cero costo (default)
#   voyage -> Voyage AI (el proveedor que Anthropic recomienda). Requiere VOYAGE_API_KEY.
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=512
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# --- Base de datos ------------------------------------------------------
# Debe coincidir con docker-compose.yml
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5433/career_copilot
REDIS_URL=redis://localhost:6380/0

# --- API ----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,chrome-extension://*
STORAGE_DIR=./storage
LOG_LEVEL=INFO

# --- Perfil por defecto (usuario local single-tenant) -------------------
DEFAULT_USER_EMAIL=me@localhost
DEFAULT_USER_NAME=Yo

# --- Frontend -----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
